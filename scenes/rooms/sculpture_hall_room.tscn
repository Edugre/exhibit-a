[node name="SculptureHall" type="Node3D"]
script = ExtResource("1_room")
editor_description = "Task B2. A hall of statues: one guard walks a long loop down both sides, past two draped statues and two empty plinths (stand on one empty-handed and she takes you for a statue), with crate stacks along the walls for cover and a throwable by the entrance. The exit is always open."

