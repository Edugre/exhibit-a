[node name="TwinArchives" type="Node3D"]
script = ExtResource("1_room")
editor_description = "Task B3. A reading room, then a wall of bookcases splitting two alcoves with a plate each. The exit gate opens only when both plates are pressed within 2 s of each other (scripts/gates/twin_plate_gate.gd), and the two players can't see each other, so they count it out. A lamp over the exit for each plate shows when it was pressed. On the way back the gate stays open."

