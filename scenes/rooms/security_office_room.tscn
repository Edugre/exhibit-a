[node name="SecurityOffice" type="Node3D"]
script = ExtResource("1_room")
editor_description = "Task B4. Where the night guards work: two guards whose patrols cross in the middle of the room, one sweeping side to side and one walking its length, on different beats, so the safe moments drift. Two pockets to hide in, out of sight wherever either guard turns: one by the door under the key board, one between the lockers and the lost-property crates. The desk is too low to hide behind. Two throwables, one by each door. The exit is always open."

