[node name="LaserCorridor" type="Node3D"]
script = ExtResource("1_room")
editor_description = "Task C3, the Hall of Arms. A wall across the middle with a laser grid in its doorway. A switch on each side drops the grid while someone stands on it: one player holds the near switch while the other crosses, then the far switch brings the first one over. The Signal Jammer drops it for both at once. A guard patrols the far half, and the alarm brings her through. Once the artifact is taken the grid stays off."

